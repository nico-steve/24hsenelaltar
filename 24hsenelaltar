
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Maratón de Oración — 24 Hs en el altar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a0c18; --panel:#12101f; --panel2:rgba(21,18,38,.55);
  --gold:#c9973f; --gold-dim:rgba(201,151,63,.35); --gold-glow:rgba(201,151,63,.55);
  --ember:#9c4d3c; --ink:#ede3d3; --muted:#948da3; --line:rgba(201,151,63,.16);
  --live:#4ade80; --live-glow:rgba(74,222,128,.55);
  --live-next:#facc15; --live-next-glow:rgba(250,204,21,.55);
  --danger:#ef4444; --danger-glow:rgba(239,68,68,.5);
}
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0; background:radial-gradient(ellipse at 50% -10%,#1b1730 0%,#0a0c18 55%,#060712 100%);
  color:var(--ink); font-family:'Work Sans',sans-serif; font-weight:300;
  overflow-x:hidden; position:relative; min-height:100%;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
h1,h2,.serif{font-family:'EB Garamond',serif}
#bgVideo{position:fixed; top:0; left:0; width:100%; height:100%; height:100lvh; object-fit:cover; object-position:center; z-index:0; transform:translateZ(0); will-change:transform}
#scrim{position:fixed; top:0; left:0; width:100%; height:100%; height:100lvh; z-index:0; transform:translateZ(0); background:linear-gradient(180deg,rgba(6,7,15,.8) 0%,rgba(6,7,15,.6) 22%,rgba(6,7,15,.62) 60%,rgba(6,7,15,.92) 100%); pointer-events:none}
canvas#particles{position:fixed; top:0; left:0; width:100%; height:100%; height:100lvh; z-index:1; pointer-events:none; transform:translateZ(0)}
.schedule-wrap{background:var(--panel2); border:1px solid var(--line); backdrop-filter:blur(10px); padding:24px 26px; border-radius:2px}
main{position:relative; z-index:2; max-width:760px; margin:0 auto; padding:64px 22px 80px}
.first-screen{min-height:100vh; min-height:100svh; display:flex; flex-direction:column; justify-content:center}
.hero{text-align:center; margin-bottom:56px}
.hero .kicker{
  display:inline-block; font-size:.78rem; font-weight:600; letter-spacing:.14em; text-transform:uppercase;
  color:var(--ink); font-style:normal; padding:7px 16px; border:1px solid var(--gold-dim);
  border-radius:100px; background:rgba(10,11,23,.55); backdrop-filter:blur(6px);
  text-shadow:0 1px 8px rgba(0,0,0,.5); box-shadow:0 0 22px rgba(201,151,63,.12);
}
h1{font-size:clamp(2.1rem,6vw,3.1rem); font-weight:600; margin:.35em 0 .1em; color:var(--ink); text-shadow:0 2px 24px rgba(0,0,0,.65),0 0 26px var(--gold-dim)}
.hero p.lead{color:var(--ink); opacity:.92; font-weight:400; font-size:1rem; line-height:1.8; max-width:520px; margin:18px auto 0; text-shadow:0 1px 3px rgba(0,0,0,.9),0 2px 14px rgba(0,0,0,.85),0 0 28px rgba(0,0,0,.7);
  background:rgba(0,0,0,.38); border-radius:16px; box-shadow:0 0 34px 26px rgba(0,0,0,.38); position:relative}
.stage{display:flex; flex-direction:column; align-items:center; gap:20px; margin:46px 0 8px}
.now{text-align:center; display:flex; flex-direction:column; align-items:center; gap:18px}
.turn{display:flex; flex-direction:column; align-items:center; gap:5px}
.now .label{
  font-size:.92rem; color:var(--ink); font-weight:700; letter-spacing:.12em; text-transform:uppercase;
  display:flex; align-items:center; justify-content:center; gap:8px;
  text-shadow:0 1px 10px rgba(0,0,0,.6);
}
.dot{
  width:9px; height:9px; border-radius:50%; background:var(--live); flex:none;
  box-shadow:0 0 0 0 var(--live-glow); animation:pulse 1.8s ease-out infinite;
}
.turn.next .dot{background:var(--live-next); box-shadow:0 0 0 0 var(--live-next-glow); animation-name:pulse-next; animation-duration:2.4s;}
@keyframes pulse{
  0%{box-shadow:0 0 0 0 var(--live-glow)}
  70%{box-shadow:0 0 0 9px rgba(74,222,128,0)}
  100%{box-shadow:0 0 0 0 rgba(74,222,128,0)}
}
@keyframes pulse-next{
  0%{box-shadow:0 0 0 0 var(--live-next-glow)}
  70%{box-shadow:0 0 0 9px rgba(250,204,21,0)}
  100%{box-shadow:0 0 0 0 rgba(250,204,21,0)}
}
.now .active-name{
  font-size:clamp(1.7rem,5.6vw,2.3rem); font-family:'EB Garamond',serif; font-style:italic; font-weight:600;
  color:var(--live); text-shadow:0 0 22px var(--live-glow),0 2px 14px rgba(0,0,0,.6); margin:2px 0;
}
.now .next-name{
  font-size:clamp(1.25rem,4.2vw,1.6rem); font-family:'EB Garamond',serif; font-style:italic; font-weight:600;
  color:var(--live-next); text-shadow:0 0 14px var(--live-next-glow),0 2px 10px rgba(0,0,0,.55); margin:2px 0;
}
.now .countdown{
  font-variant-numeric:tabular-nums; font-size:clamp(1.7rem,6vw,2.2rem); font-weight:700;
  color:var(--danger); text-shadow:0 0 18px var(--danger-glow),0 2px 10px rgba(0,0,0,.6); margin-top:2px;
}
.divider{width:100%; height:1px; background:linear-gradient(90deg,transparent,var(--line),transparent); margin:52px 0}
h2{font-size:1.5rem; font-weight:600; margin:0 0 6px; color:var(--ink)}
.section-sub{color:var(--muted); font-size:.86rem; margin:0 0 22px; line-height:1.6}
.schedule{display:grid; grid-template-columns:1fr 1fr; gap:0 28px}
@media (max-width:560px){.schedule{grid-template-columns:1fr}}
.row{
  display:flex; align-items:baseline; justify-content:space-between; gap:10px;
  padding:10px 4px; border-bottom:1px solid var(--line); cursor:default;
  transition:background .25s ease, padding-left .25s ease;
}
.row:hover{background:linear-gradient(90deg,var(--gold-dim),transparent); padding-left:10px}
.row .time{font-size:.82rem; color:var(--muted); white-space:nowrap; font-variant-numeric:tabular-nums; flex:none}
.row .names{font-family:'EB Garamond',serif; font-size:1.02rem; text-align:right; min-width:0; flex:1 1 auto; overflow-wrap:break-word}
.row.active{border-bottom-color:var(--live)}
.row.active .time{color:var(--live); font-size:.92rem}
.row.active .names{color:var(--live); font-size:1.4rem; font-style:italic; text-shadow:0 0 16px var(--live-glow)}
.row.next{border-bottom-color:rgba(250,204,21,.45)}
.row.next .names{color:var(--live-next); font-weight:600; font-size:1.12rem}
.row.active .names::before{
  content:''; display:inline-block; width:7px; height:7px; border-radius:50%;
  background:var(--live); margin-right:8px; box-shadow:0 0 6px var(--live-glow); vertical-align:middle;
}
.row.next .names::before{
  content:''; display:inline-block; width:7px; height:7px; border-radius:50%;
  background:var(--live-next); margin-right:8px; box-shadow:0 0 6px var(--live-next-glow); vertical-align:middle;
}
.card{
  background:var(--panel2); border:1px solid var(--line); border-radius:2px;
  backdrop-filter:blur(10px); padding:26px 28px; margin-bottom:18px;
}
.card p{color:#d8cfc0; line-height:1.75; font-size:.94rem; margin:0 0 12px}
.card p:last-child{margin-bottom:0}
.fast-row{display:flex; align-items:center; gap:14px; margin-bottom:16px}
.flame{width:26px; height:26px; flex:none}
footer{text-align:center; margin-top:60px; color:var(--muted); font-family:'EB Garamond',serif; font-style:italic; font-size:1.05rem; line-height:1.7}
footer .copyright{margin-top:22px; font-family:'Work Sans',sans-serif; font-style:normal; font-size:.72rem; letter-spacing:.03em; color:var(--muted); opacity:.7}
@media (max-width:480px){
  main{padding:44px 16px 60px}
  .hero{margin-bottom:38px}
  .hero .kicker{font-size:.7rem; padding:6px 13px}
  .stage{margin:34px 0 8px; gap:16px}
  .schedule-wrap{padding:18px 16px}
  .card{padding:20px 18px}
  .divider{margin:36px 0}
}
@media (max-width:360px){
  h1{font-size:1.85rem}
  .now .active-name{font-size:1.5rem}
  .now .next-name{font-size:1.1rem}
  .now .countdown{font-size:1.5rem}
}
@media (max-height:520px) and (orientation:landscape){
  main{padding:26px 22px 40px}
  .hero{margin-bottom:20px}
  .stage{margin:20px 0 8px; gap:10px}
  .divider{margin:24px 0}
}
@media (hover:none){
  .row:hover{background:none; padding-left:4px}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important; transition:none!important}}
</style>
</head>
<body>
<video id="bgVideo" autoplay muted loop playsinline preload="auto"><source src="data:video/mp4;base64," type="video/mp4"></video>
<div id="scrim"></div>
<canvas id="particles"></canvas>
<main>
  <div class="first-screen">
  <div class="hero">
    <div class="kicker">24 Hs en el altar</div>
    <h1>Maratón de Oración</h1>
    <p class="lead">Durante 24 hs vamos a estar unidos bajo un mismo propósito: buscar a Dios. Pondremos nuestras vidas, nuestra familia, nuestra iglesia y tantas necesidades delante de Él. No será una actividad más, sino un tiempo en el que experimentaremos que cuando la iglesia se une para buscar a Dios, Él está en medio de su pueblo.</p>
  </div>

  <div class="stage">
    <div class="now">
      <div class="turn current">
        <div class="label"><span class="dot"></span>Turno actual</div>
        <div class="active-name" id="activeName">—</div>
      </div>
      <div class="countdown" id="countdown">00:00</div>
      <div class="turn next">
        <div class="label"><span class="dot"></span>Próximo turno</div>
        <div class="next-name" id="nextName">—</div>
      </div>
    </div>
  </div>
  </div>

  <div class="divider"></div>

  <div class="schedule-wrap">
    <h2>Turnos de oración</h2>
    <div class="schedule">
      <div id="colA"></div>
      <div id="colB"></div>
    </div>
  </div>

  <div class="divider"></div>

  <div class="card">
    <div class="fast-row">
      <svg class="flame" viewBox="0 0 24 24" fill="none">
        <path d="M12 2c1 3-3 4-3 8a3 3 0 0 0 6 0c0-1-.5-2-1-2.5 1.5 1 2.5 3 2.5 5a4.5 4.5 0 0 1-9 0C7.5 8.5 11 7 12 2Z" fill="var(--gold)" opacity=".85"/>
      </svg>
      <h2 style="margin:0">Ayuno</h2>
    </div>
    <p><strong style="color:var(--ink)">Leyla · Marta · Cristian · Pastor.</strong> Desde las 00:00 hs del lunes hasta las 12:00 o hasta las 18:00 hs, eso lo sabrá cada hermano. El ayuno es para apoyar a todos los hermanos comprometidos con esta actividad.</p>
  </div>

  <div class="card">
    <h2>Pedidos de oración</h2>
    <p>Por nosotros mismos, para que Dios trate con nosotros en esta hora de oración, entregando nuestra vida delante de Él y reconociendo su grandeza.</p>
    <p>Oración por el Geriátrico y por el hogar de niños. Son dos generaciones muy importantes: una está terminando sus días y la otra está comenzando; ambas necesitan a Dios.</p>
    <p>Por nuestros hermanos que están en tiempo de enfermedad, para que en la gracia de Dios reciban sanidad. También por familiares de nuestros hermanos: las batallas de un familiar también nos afectan.</p>
  </div>

  <div class="card">
    <p>Oremos por las ventas a favor de la iglesia, están siendo de gran bendición, y por los hermanos que invierten su valioso tiempo para que sigamos adelante.... (Hay recompensa para tu trabajo)</p>
    <p>Toma un tiempo para leer una palabra y luego seguir con la oración. Que te habló ese versículo, ora por eso; se rompen cadenas cuando oramos afirmados en una palabra de Dios.</p>
    <p>Por las almas que pasaron por TDV y por todos aquellos que fueron invitados a participar de las reuniones. Lo más probable es que quieran participar, pero al estar enfocados en sus problemas, no pueden ver que la salida está en Jesús.</p>
    <p>Respaldamos en oración a los hermanos que están ayunando en favor nuestro.</p>
  </div>

  <footer>Éxito y mucha bendición en esta Maratón para todos.<br>Siempre en Movimiento.<div class="copyright">© 2026 Nicolas Creation Studios. Todos los derechos reservados.</div></footer>
</main>

<script>
const schedule=[
[0,"Mili / María / Lucas"],[1,"Leyla"],[2,"Martín"],[3,"Norma / Ricardo / Daiana"],
[4,"Pastor"],[5,"Cristian"],[6,"Gabriela / Zulema"],[7,"Lidia B"],
[8,"Diego"],[9,"Tamara / Sandra"],[10,"Marta / Andrea"],[11,"Mirta"],
[12,"José"],[13,"Pastora"],[14,"Susana"],[15,"Ariel / Estela"],
[16,"Gustavo"],[17,"Matías"],[18,"Marcos / Claudio"],[19,"Luis / Nicolás"],
[20,"Ángel"],[21,"Lidia A"],[22,"Elizabeth / Mauro"],[23,"Mabel / Isabel"]
];
function fmt(h){return (h%24).toString().padStart(2,'0')+' hs';}
const colA=document.getElementById('colA'), colB=document.getElementById('colB');
const rows=[];
schedule.forEach(([h,names],i)=>{
  const r=document.createElement('div'); r.className='row'; r.dataset.h=h;
  r.innerHTML=`<span class="time">${fmt(h)} a ${fmt(h+1)}</span><span class="names">${names}</span>`;
  r.addEventListener('mouseenter',()=>chime(220+h*14));
  (i<12?colA:colB).appendChild(r);
  rows.push(r);
});

/* ---- audio ---- */
let actx;
function chime(freq){
  try{
    actx=actx||new (window.AudioContext||window.webkitAudioContext)();
    if(actx.state==='suspended') actx.resume();
    const t=actx.currentTime, o=actx.createOscillator(), g=actx.createGain();
    o.type='sine'; o.frequency.value=freq;
    g.gain.setValueAtTime(0,t);
    g.gain.linearRampToValueAtTime(.05,t+.02);
    g.gain.exponentialRampToValueAtTime(.0001,t+.5);
    o.connect(g); g.connect(actx.destination);
    o.start(t); o.stop(t+.5);
  }catch(e){}
}

/* ---- background video: force seamless infinite loop ---- */
const bgVideo=document.getElementById('bgVideo');
if(bgVideo){
  bgVideo.addEventListener('ended',()=>{ bgVideo.currentTime=0; bgVideo.play().catch(()=>{}); });
  const tryPlay=()=>bgVideo.play().catch(()=>{});
  tryPlay();
  document.addEventListener('visibilitychange',()=>{ if(!document.hidden) tryPlay(); });
}

/* ---- particles: dynamic embers floating across the whole screen (canvas, responsive, organic motion) ---- */
const pc=document.getElementById('particles');
const pctx=pc.getContext('2d');
const N=42;
let parts=[], particlesReady=false;

function spawnParticle(w,h){
  const depth=Math.random();               // 0 = far/small/dim, 1 = near/big/bright (perspective)
  const speed=.18+depth*.55;                // closer particles drift a bit faster (parallax)
  const angle=Math.random()*Math.PI*2;      // random direction
  return {
    x:Math.random()*w, y:Math.random()*h,
    vx:Math.cos(angle)*speed, vy:Math.sin(angle)*speed,
    r:.8+depth*2.4, depth,
    baseOp:.07+depth*.2,
    wobble:Math.random()*Math.PI*2, wobbleSpeed:.006+Math.random()*.012
  };
}
// spawns a fresh particle entering from a random edge, heading inward (used to replace ones that left)
function spawnEdgeParticle(w,h){
  const depth=Math.random();
  const speed=.18+depth*.55;
  const edge=Math.floor(Math.random()*4), margin=6, spread=Math.PI/2, jitter=(Math.random()-.5)*spread;
  let x,y,angle;
  if(edge===0){      x=-margin;   y=Math.random()*h; angle=0+jitter; }        // left  -> heading right
  else if(edge===1){ x=w+margin;  y=Math.random()*h; angle=Math.PI+jitter; }  // right -> heading left
  else if(edge===2){ x=Math.random()*w; y=-margin;   angle=Math.PI/2+jitter; }// top   -> heading down
  else {             x=Math.random()*w; y=h+margin;  angle=-Math.PI/2+jitter;}// bottom-> heading up
  return {
    x,y,
    vx:Math.cos(angle)*speed, vy:Math.sin(angle)*speed,
    r:.8+depth*2.4, depth,
    baseOp:.07+depth*.2,
    wobble:Math.random()*Math.PI*2, wobbleSpeed:.006+Math.random()*.012
  };
}
function sizeP(){
  const ow=pc.width, oh=pc.height;
  pc.width=innerWidth; pc.height=innerHeight;
  if(!particlesReady){
    parts=Array.from({length:N},()=>spawnParticle(pc.width,pc.height));
    particlesReady=true;
  }else if(ow>0 && oh>0){
    const rx=pc.width/ow, ry=pc.height/oh;   // reflow proportionally on resize
    parts.forEach(p=>{ p.x*=rx; p.y*=ry; });
  }
}
sizeP(); let lastW=innerWidth; addEventListener('resize',()=>{ if(innerWidth!==lastW){ lastW=innerWidth; sizeP(); } }); /* ignore height-only resizes (mobile address bar on scroll) */

let ptrX=-9999, ptrY=-9999, ptrActive=false;
function setPtr(x,y){ ptrX=x; ptrY=y; ptrActive=true; }
addEventListener('pointermove', e=>setPtr(e.clientX,e.clientY), {passive:true});
addEventListener('pointerdown', e=>setPtr(e.clientX,e.clientY), {passive:true});
addEventListener('pointerleave', ()=>{ ptrActive=false; });
addEventListener('touchmove', e=>{ if(e.touches[0]) setPtr(e.touches[0].clientX,e.touches[0].clientY); }, {passive:true});

function lerp(a,b,t){ return a+(b-a)*t; }
const FAR_C=[156,77,60], NEAR_C=[233,196,132]; // ember (far) -> warm gold (near), for depth feel

function drawParticles(){
  const w=pc.width, h=pc.height;
  pctx.clearRect(0,0,w,h);
  parts.forEach((p,i)=>{
    p.wobble+=p.wobbleSpeed;
    p.x+=p.vx+Math.sin(p.wobble)*.12;
    p.y+=p.vy+Math.cos(p.wobble*.8)*.1;

    // instead of bouncing off the margins, the particle disappears past the edge
    // and a new one enters from a random side to take its place
    const margin=p.r+18;
    if(p.x<-margin||p.x>w+margin||p.y<-margin||p.y>h+margin){
      p=spawnEdgeParticle(w,h);
      parts[i]=p;
    }

    let dx2=p.x, dy2=p.y;
    if(ptrActive){
      const dx=p.x-ptrX, dy=p.y-ptrY, dist=Math.hypot(dx,dy), rad=100;
      if(dist<rad){
        const push=(rad-dist)/rad*20;
        const nx=dist?dx/dist:0, ny=dist?dy/dist:0;
        dx2+=nx*push; dy2+=ny*push;
      }
    }

    const cr=Math.round(lerp(FAR_C[0],NEAR_C[0],p.depth));
    const cg=Math.round(lerp(FAR_C[1],NEAR_C[1],p.depth));
    const cb=Math.round(lerp(FAR_C[2],NEAR_C[2],p.depth));
    const op=p.baseOp;

    pctx.save();
    pctx.shadowBlur=p.r*4.5;
    pctx.shadowColor=`rgba(${cr},${cg},${cb},${Math.min(.8,op*1.6)})`;
    pctx.beginPath();
    pctx.fillStyle=`rgba(${cr},${cg},${cb},${op})`;
    pctx.arc(dx2,dy2,p.r,0,Math.PI*2);
    pctx.fill();
    pctx.restore();
  });
}

/* ---- clock loop ---- */
const nameEl=document.getElementById('activeName'), nextEl=document.getElementById('nextName'), cdEl=document.getElementById('countdown');
function tick(){
  const now=new Date(), h=now.getHours(), m=now.getMinutes(), s=now.getSeconds();
  const secInHour=m*60+s;
  const nextH=(h+1)%24;
  rows.forEach(r=>{
    const rh=+r.dataset.h;
    r.classList.toggle('active', rh===h);
    r.classList.toggle('next', rh===nextH);
  });
  nameEl.textContent=schedule[h][1];
  nextEl.textContent=schedule[nextH][1];
  const rem=3600-secInHour;
  cdEl.textContent=String(Math.floor(rem/60)).padStart(2,'0')+':'+String(rem%60).padStart(2,'0')+' restantes';
}
function loop(){ drawParticles(); requestAnimationFrame(loop); }
tick(); setInterval(tick,1000); requestAnimationFrame(loop);
</script>
</body>
</html>
